{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitsune",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "kv_namespaces": [
    {
      "binding": "db",
      "id": "kitsune_db",
    }
  ],
  "routes": [
    {
      "pattern": "krish.pics",
      "zone_name": "krish.pics",
      "custom_domain": true
    }
  ]
}