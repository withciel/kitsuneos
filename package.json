{
  "name": "kitsuneos",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "acceptance": "pnpm --filter @kitsuneos/acceptance test",
    "acceptance:loop": "node scripts/acceptance-loop.mjs",
    "db:init": "sudo -u postgres psql -f scripts/db-init.sql && pnpm --filter @kitsuneos/core run migrate",
    "lint": "biome check .",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  }
}
