{
  "name": "kitsuneos",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "quickstart": "pnpm -r run build && pnpm --filter @kitsuneos/cli run quickstart",
    "review": "pnpm --filter @kitsuneos/cli run review",
    "history": "pnpm --filter @kitsuneos/cli run history",
    "acceptance": "pnpm --filter @kitsuneos/acceptance test",
    "acceptance:loop": "node scripts/acceptance-loop.mjs",
    "lint": "biome check . && node scripts/lint-sql-templates.mjs",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  }
}
