{
  "name": "@kitsuneos/mcp",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kitsuneos-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./invoke": {
      "types": "./dist/invoke.d.ts",
      "import": "./dist/invoke.js"
    }
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p='dist/stdio.js';const t=fs.readFileSync(p,'utf8');if(!t.startsWith('#!'))fs.writeFileSync(p,'#!/usr/bin/env node\\n'+t);\"",
    "typecheck": "tsc --noEmit",
    "start": "node dist/stdio.js"
  },
  "dependencies": {
    "@kitsuneos/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "5.9.2"
  }
}
